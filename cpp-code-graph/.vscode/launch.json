{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (sample project)",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "npm: build",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/sample"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    }
  ]
}